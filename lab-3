using namespace std;

bool isVowel(char c) {
    c = tolower(static_cast<unsigned char>(c));
    return (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u');
}

void replaceVowels(string& s) {
    transform(s.begin(), s.end(), s.begin(), [](char c) {
        return isVowel(c) ? '*' : c;
    });
}

template <typename Container>
void printContainer(const Container& container) {
    for (const auto& elem : container) {
        cout << elem << " ";
    }
    cout << endl;
}

template <typename Container>
void printWordsStartingWithA(const Container& container) {
    for (const auto& word : container) {
        if (!word.empty() && word[0] == 'a') {
            cout << word << endl;
        }
    }
}

int main() {
    SetConsoleOutputCP(65001);
    SetConsoleCP(65001);

    array<string, 50> arr = {
        "fluctuation", "total", "different", "suntan", "industry", "exercise",
        "beer", "sum", "substitute", "triangle", "sick", "gem", "tragedy",
        "suit", "gallery", "owner", "cherry", "wound", "friendly", "galaxy",
        "execute", "so", "leader", "hole", "shift", "haunt", "apathy",
        "technology", "last", "consensus", "company", "board", "pony", "tumble",
        "dawn", "record", "recommendation", "kettle", "ally", "patrol", "insert",
        "meat", "extraterrestrial", "deliver", "burn", "storm", "reliance",
        "disturbance", "payment", "observation"
    };

    vector<string> vec(arr.begin(), arr.end());
    list<string> listik(arr.begin(), arr.end());

    cout << "Слова на 'a':" << endl;
    printWordsStartingWithA(arr);
    cout << endl;
    printWordsStartingWithA(vec);
    cout << endl;
    printWordsStartingWithA(listik);
    cout << endl;

    cout << "Самое длинное слово:" << endl;
    cout << *max_element(arr.begin(), arr.end(),
        [](const string& a, const string& b) { return a.size() < b.size(); }) << endl;
    cout << *max_element(vec.begin(), vec.end(),
        [](const string& a, const string& b) { return a.size() < b.size(); }) << endl;
    cout << *max_element(listik.begin(), listik.end(),
        [](const string& a, const string& b) { return a.size() < b.size(); }) << endl;
    cout << endl;

    for (auto& s : arr) {

#include <iostream>
#include <array>
#include <vector>
#include <list>
#include <iterator>
#include <random>
#include <algorithm>
#include <windows.h>

using namespace std;

void printContainer(const vector<int> &numbersVector, const list<int> &numbersList) {
    cout << "Vector: ";
    for (const int i: numbersVector) {
        cout << i << " ";
    }

    cout << "\nList: ";
    auto currentElement = numbersList.begin();
    for (int i = 0; i < numbersList.size(); i++) {
        cout << *currentElement++ << " ";
    }

    cout << endl;
}

int main() {
    SetConsoleOutputCP(65001);
    SetConsoleCP(65001);

    array<int, 100> numbersArray = {};
    vector<int> numbersVector(100);
    list<int> numbersList(100);

    random_device randomDevice;
    mt19937 engine(randomDevice());
    uniform_int_distribution<int> distribution(1, 1000);

    generate(numbersArray.begin(), numbersArray.end(), [&]() {
        return distribution(engine);
    });
    generate(numbersVector.begin(), numbersVector.end(), [&]() {
        return distribution(engine);
    });
    generate(numbersList.begin(), numbersList.end(), [&]() {
        return distribution(engine);
    });

    cout << "Контейнеры до изменений:" << endl;
    printContainer(numbersVector, numbersList);
    cout << endl;

    numbersVector.insert(numbersVector.begin() + 50, 999);
    auto currentListElement = numbersList.begin();
    advance(currentListElement, 50);
    numbersList.insert(currentListElement, 999);

    numbersVector.erase(numbersVector.begin() + 25);
    currentListElement = numbersList.begin();
    advance(currentListElement, 25);
    numbersList.erase(currentListElement);

    auto vectorIterator = numbersVector.begin();
    while (vectorIterator != numbersVector.end()) {
        if (*vectorIterator > 500)
            vectorIterator = numbersVector.erase(vectorIterator);
        else
            ++vectorIterator;
    }

    currentListElement = numbersList.begin();
    while (currentListElement != numbersList.end()) {
        if (*currentListElement > 500)
            currentListElement = numbersList.erase(currentListElement);
        else
            ++currentListElement;
    }

    cout << "Контейнеры после изменений:" << endl;
    printContainer(numbersVector, numbersList);
    cout << endl;

    cout << "Результаты:" << endl;
    cout << "Осталось элементов в Vector: " << numbersVector.size() << endl;
    cout << "Осталось элементов в List:   " << numbersList.size() << endl;

    return 0;
}

#include <iostream>
#include <string>
#include <array>
#include <vector>
#include <list>
#include <algorithm>
#include <windows.h>

using namespace std;

struct Student {
    string name;
    int id;
    double gpa;
};

void printStudent(const Student& student) {
    cout << "<" << student.id << ">:'" << student.name << "'(" << student.gpa << ")" << endl;
}

template <typename Container>
void printFirstFive(const Container& container) {
    auto current = container.begin();
    for (int i = 0; i < 5; i++) {
        printStudent(*current);
        ++current;
    }
    cout << endl;
}

int main() {
    SetConsoleOutputCP(65001);
    SetConsoleCP(65001);

    array<Student, 1000> studentsArray;
    vector<Student> studentsVector;
    list<Student> studentsList;

    studentsVector.resize(1000);

    for (int i = 0; i < 1000; i++) {
        Student student = { "Вася" + to_string(i), i, (double)(rand() % 10001) / 100 };
        studentsArray[i] = student;
        studentsVector[i] = student;
        studentsList.push_back(student);
    }

    auto gpaSort = [](const Student& a, const Student& b) {
        return a.gpa > b.gpa;
    };

    auto idSort = [](const Student& a, const Student& b) {
        return a.id < b.id;
    };

    auto nameSort = [](const Student& a, const Student& b) {
        return a.name < b.name;
    };

    cout << "Сортировка по gpa:" << endl;
    sort(studentsArray.begin(), studentsArray.end(), gpaSort);
    sort(studentsVector.begin(), studentsVector.end(), gpaSort);
    studentsList.sort(gpaSort);

    printFirstFive(studentsArray);
    printFirstFive(studentsVector);
    printFirstFive(studentsList);

    cout << "Сортировка по id:" << endl;
    sort(studentsArray.begin(), studentsArray.end(), idSort);
    sort(studentsVector.begin(), studentsVector.end(), idSort);
    studentsList.sort(idSort);

    printFirstFive(studentsArray);
    printFirstFive(studentsVector);
    printFirstFive(studentsList);

    cout << "Сортировка по name:" << endl;
    sort(studentsArray.begin(), studentsArray.end(), nameSort);
    sort(studentsVector.begin(), studentsVector.end(), nameSort);
    studentsList.sort(nameSort);

    printFirstFive(studentsArray);
    printFirstFive(studentsVector);
    printFirstFive(studentsList);

    return 0;
}


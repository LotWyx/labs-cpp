#include <iostream>
#include <array>
#include <vector>
#include <list>
#include <random>
#include <chrono>
#include <iterator>
#include <windows.h>

using namespace std;

template <typename F, typename... Args>
double getTime(F&& func, Args&&... args) {
    auto start = chrono::steady_clock::now();
    func(args...);
    auto end = chrono::steady_clock::now();
    chrono::duration<double, milli> elapsed = end - start;
    return elapsed.count();
}

int main() {
    SetConsoleOutputCP(65001);
    SetConsoleCP(65001);

    random_device rd;
    mt19937 gen(rd());
    uniform_int_distribution<> distrib(0, 1000);

    array<int, 100000> numbersArray;
    vector<int> numbersVector;
    list<int> numbersList;

    numbersVector.resize(100000);

    for (int i = 0; i < 100000; i++) {
        numbersArray[i] = distrib(gen);
        numbersVector[i] = distrib(gen);
        numbersList.push_back(distrib(gen));
    }

    cout << "(Время в миллисекундах)" << endl;
    cout << endl;

    cout << "Обход элементов и сумма:" << endl;
    cout << endl;

    cout << "Время array: " << getTime([](array<int, 100000>& numbersArray) {
        int sum = 0;
        for (int i = 0; i < 100000; i++) {
            sum += numbersArray[i];
        }
        cout << "Сумма: " << sum << endl;
    }, numbersArray) << endl;

    cout << "Время vector: " << getTime([](vector<int>& numbersVector) {
        int sum = 0;
        for (int i = 0; i < 100000; i++) {
            sum += numbersVector[i];
        }
        cout << "Сумма: " << sum << endl;
    }, numbersVector) << endl;

    cout << "Время list: " << getTime([](list<int>& numbersList) {
        int sum = 0;
        auto current = numbersList.begin();
        for (int i = 0; i < 100000; i++) {
            sum += *current;
            current++;
        }
        cout << "Сумма: " << sum << endl;
    }, numbersList) << endl;

    cout << endl;
    cout << "Произвольный доступ:" << endl;
    cout << endl;

    cout << "Время array: " << getTime([](array<int, 100000>& numbersArray) {
        cout << "Элементы: " << numbersArray[0] << " " << numbersArray[25000] << " " << numbersArray[50000] << " " << numbersArray[75000] << " " << numbersArray[99999] << endl;
    }, numbersArray) << endl;

    cout << "Время vector: " << getTime([](vector<int>& numbersVector) {
        cout << "Элементы: " << numbersVector[0] << " " << numbersVector[25000] << " " << numbersVector[50000] << " " << numbersVector[75000] << " " << numbersVector[99999] << endl;
    }, numbersVector) << endl;

    cout << "Время list: " << getTime([](list<int>& numbersList) {
        auto current = numbersList.begin();
        cout << "Элементы: "
             << *current << " "
             << *next(current, 25000) << " "
             << *next(current, 50000) << " "
             << *next(current, 75000) << " "
             << *next(current, 99999) << endl;
    }, numbersList) << endl;

    cout << endl;
    cout << "Вставка в конец:" << endl;
    cout << endl;

    cout << "[array не поддерживает]" << endl;

    cout << "Время vector: " << getTime([](vector<int>& numbersVector) {
        for (int i = 0; i < 1000; i++) {
            numbersVector.push_back(i);
        }
    }, numbersVector) << endl;

    cout << "Время list: " << getTime([](list<int>& numbersList) {
        for (int i = 0; i < 1000; i++) {
            numbersList.push_back(i);
        }
    }, numbersList) << endl;

    cout << endl;
    cout << "Вставка в середину:" << endl;
    cout << endl;

    cout << "[array не поддерживает]" << endl;

    cout << "Время vector: " << getTime([](vector<int>& numbersVector) {
        for (int i = 0; i < 100; i++) {
            numbersVector.insert(numbersVector.begin() + 50000, i);
        }
    }, numbersVector) << endl;

    cout << "Время list: " << getTime([](list<int>& numbersList) {
        auto current = next(numbersList.begin(), 50000);
        for (int i = 0; i < 100; i++) {
            numbersList.insert(current, i);
        }
    }, numbersList) << endl;

    cout << endl;
    cout << "Удаление из середины:" << endl;
    cout << endl;

    cout << "[array не поддерживает]" << endl;

    cout << "Время vector: " << getTime([](vector<int>& numbersVector) {
        for (int i = 0; i < 100; i++) {
            numbersVector.erase(numbersVector.begin() + 50000);
        }
    }, numbersVector) << endl;

    cout << "Время list: " << getTime([](list<int>& numbersList) {
        auto current = next(numbersList.begin(), 50000);
        for (int i = 0; i < 100; i++) {
            auto temp = current;
            ++current;
            numbersList.erase(temp);
        }
    }, numbersList) << endl;

    return 0;
}
